<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Auto-Tobe-Agent launchd 배치 설정 (Tier 2: Fix 배치)
  사람 비활성 시간(새벽)에 1회만 실행하여 개발자 작업과의 충돌을 회피합니다.
    - 00:30 단일 수정 배치 (QA Agent 전날 23:00 점검 + 23:30 DB 마이그레이션 결과 처리)
      · 23:30 QA Migration 종료와 1h 버퍼
      · 04:30 medium-digest 시작과 4h 버퍼
      · 06~09시 deploy 창구와 5.5h 버퍼

  설치:
    1. 이 파일의 경로를 운영 환경에 맞게 수정하세요 (AGENT_HOME, HOME 등)
    2. cp scripts/com.bluevlad.auto-tobe-agent.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.bluevlad.auto-tobe-agent.plist

  주의: 경로에 실제 사용자명/서버 정보를 포함하지 않도록 local.json에서 오버라이드하세요.
  참조: AGENT_CONFLICT_PREVENTION_GUIDE.md §2.1 (시간대 분리 전략)
-->
<dict>
    <key>Label</key>
    <string>com.bluevlad.auto-tobe-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>${AGENT_HOME}/scripts/run-batch.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>${AGENT_HOME}</string>

    <key>StandardOutPath</key>
    <string>${AGENT_HOME}/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>${AGENT_HOME}/logs/launchd-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>AbandonProcessGroup</key>
    <false/>
</dict>
</plist>
